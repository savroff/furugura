#!/usr/bin/env bash
#
# Thin pyannote.audio diarization wrapper.
#
# Resolves a Python with `pyannote.audio` installed (pipx venv first,
# then system python), then runs an inline diarization driver that
# reads the wav path + optional file_id from argv and the HF token
# from $HF_TOKEN.
#
# Output: RTTM rows on stdout. Errors and pyannote progress logs on stderr.

set -euo pipefail

PIPX_PY="$HOME/.local/share/pipx/venvs/pyannote-audio/bin/python"
SYS_PY="$(command -v python3 || command -v python || true)"

PY=""
for candidate in "$PIPX_PY" "$SYS_PY"; do
    if [[ -n "$candidate" && -x "$candidate" ]] \
       && "$candidate" -c "import pyannote.audio" 2>/dev/null; then
        PY="$candidate"
        break
    fi
done

if [[ -z "$PY" ]]; then
    {
        echo "pyannote_runner: no Python with pyannote.audio installed found."
        echo "  (tried: $PIPX_PY and $SYS_PY)"
        echo "  Install with: pipx install pyannote.audio"
    } >&2
    exit 3
fi

exec "$PY" - "$@" <<'PYTHON'
"""Inline diarization driver. Receives wav + optional file_id on argv."""
import os
import sys


def main() -> int:
    if len(sys.argv) < 2 or len(sys.argv) > 3:
        print("usage: pyannote_runner <wav> [file_id]", file=sys.stderr)
        return 2

    wav = sys.argv[1]
    file_id = sys.argv[2] if len(sys.argv) == 3 else "meeting"

    token = os.environ.get("HF_TOKEN")
    if not token:
        print("HF_TOKEN env var is required", file=sys.stderr)
        return 2

    from pyannote.audio import Pipeline

    pipeline = Pipeline.from_pretrained(
        "pyannote/speaker-diarization-3.1",
        use_auth_token=token,
    )
    diarization = pipeline(wav)

    for turn, _, speaker in diarization.itertracks(yield_label=True):
        print(
            f"SPEAKER {file_id} 1 {turn.start:.3f} {turn.duration:.3f} "
            f"<NA> <NA> {speaker} <NA> <NA>"
        )
    return 0


if __name__ == "__main__":
    sys.exit(main())
PYTHON
